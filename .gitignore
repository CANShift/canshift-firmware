# PlatformIO build cache and artifacts
.pio/

# clang-tidy compilation database (regenerated by `pio run -t compiledb`)
compile_commands.json

# Compiled binaries
*.bin
*.elf
*.hex
*.map

# Allow SPIFFS font + image assets
!data/fonts/*.bin
!data/assets/*.bin

# Dash-hosted Studio SPA — mirrored at firmware build time from
# canshift-studio-web/dist/ by scripts/sync_studio_web.py (#1077 phase 4).
# Generated artifact, never committed.
data/web/

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Environment
.env
.env.*

# Build-time secrets (OTA HMAC key) — populated locally, never committed
secrets.ini

# Secure-boot artifacts — NEVER commit.
secrets/
keys/
*.pem

# Claude (local only)
.claude/
