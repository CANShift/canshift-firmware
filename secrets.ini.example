; secrets.ini.example — copy to secrets.ini (gitignored) and fill in.
;
; Read by scripts/extra_targets.py at build time and injected into the
; firmware as build-time #defines. Never commit the populated secrets.ini.
;
; Generate a fresh OTA HMAC secret with:
;   openssl rand -hex 32
;
; Both the studio (when packaging firmware) and the mobile app (when pushing
; firmware) must use the SAME secret to compute the trailer the firmware
; verifies. Rotate by re-flashing every device.

[ota]
hmac_secret = REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
