# PlatformIO build cache and artifacts
.pio/

# Compiled binaries
*.bin
*.elf
*.hex
*.map

# Allow SPIFFS font assets
!data/fonts/*.bin
# Allow SPIFFS image assets (SPIFFS-first architecture)
!data/assets/*.bin
# Allow LVGL image assets shipped on the SD card (legacy / opt-in only)
!sd_contents/assets/*.bin

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Environment
.env
.env.*

# Claude (local only)
.claude/
