# .clang-tidy — Semantic static-analysis checks for the firmware
# (#936 Phase 0 + Phase 1).
#
# Narrow, sustainable ruleset. The enabled families are the highest-signal /
# lowest-noise checks for embedded C++17 against the bug classes this codebase
# has historically taken (UB shifts #682, races #876, leaks / use-after-free
# #886, missing length validation #897):
#
#   bugprone-*                                 Anti-patterns prone to bugs.
#   cert-*                                     CERT secure-coding rules.
#   clang-analyzer-core.*                      Null deref, uninit reads, …
#   clang-analyzer-cplusplus.*                 new/delete, self-assign, move.
#   concurrency-*                              Multi-task threading checks.
#
# Phase 1 additions (#936 Phase 1) — small, high-quality bumps:
#   performance-*                              Unnecessary copies, emplace, …
#                                              (no violations across the
#                                              native subset).
#   cppcoreguidelines-pro-type-cstyle-cast     Ban C-style casts (already 0).
#   cppcoreguidelines-pro-type-static-cast-downcast
#                                              Ban unchecked downcasts (0).
#   cppcoreguidelines-pro-type-member-init     Catch local POD structs whose
#                                              members forget to init —
#                                              already caught two latent UB
#                                              risks in config_loader.cpp.
#   cppcoreguidelines-pro-type-reinterpret-cast
#                                              Force a deliberate NOLINT at
#                                              each reinterpret_cast (one,
#                                              for Serial.write char[] →
#                                              uint8_t* API boundary, see
#                                              diag/logger.cpp).
#
# Deliberately NOT enabled (would explode against legitimate firmware
# patterns — hardware constants, GSL-less bounds checks, ESP-IDF macros):
#   - cppcoreguidelines-pro-bounds-*           Pointer arithmetic & raw array
#                                              indexing — drowns signal in
#                                              CAN parsers / config IO.
#   - cppcoreguidelines-avoid-magic-numbers    Hardware register addresses.
#   - readability-identifier-length            Idiomatic short names (i, r).
#   - modernize-macro-to-enum                  app_config.h macros are shared
#                                              with .cpp / build flags /
#                                              Python codegen.
#
# Selectively disabled inside enabled families because they fire too noisily
# on Arduino-style code or duplicate signal already covered by -Wall / -Wextra:
#   - bugprone-easily-swappable-parameters    Half the LVGL API.
#   - bugprone-narrowing-conversions          int → uint8_t everywhere LVGL touches.
#   - bugprone-implicit-widening-of-multiplication-result  Same as above.
#   - cert-dcl50-cpp                          Variadic Logger::emit signature.
#   - cert-err33-c                            Arduino APIs (Serial.print,
#                                             pinMode) return void / ignored ints.
#   - cert-err58-cpp                          Arduino global init pattern
#                                             (constructors run before main).
#
# WarningsAsErrors: '*' — any rule violation in source that parses cleanly
# is treated as an error. The gating CI job (ci.yml `firmware — clang-tidy
# (gating, native subset)`) runs against the native env compile DB where
# every TU resolves with system clang; promoting to errors there makes the
# job a true required check.
#
# HeaderFilterRegex restricts the report to first-party code so third-party
# libs (LovyanGFX, LVGL, ArduinoJson, NimBLE) don't drown the signal.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  concurrency-*,
  performance-*,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-reinterpret-cast,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  -cert-dcl50-cpp,
  -cert-err33-c,
  -cert-err58-cpp

# Promote every emitted rule finding to an error. The gating CI job fails
# on the first violation; the legacy informational job (which runs against
# the Xtensa compile DB and is dominated by toolchain-induced
# clang-diagnostic-error noise — see ci.yml footnote) stays
# `continue-on-error: true` until ESP-IDF's Xtensa-aware clang lands in CI.
WarningsAsErrors: '*'

# Restrict header analysis to first-party code. clang-tidy uses regex_search
# so the pattern must anchor at start (`^`) — without it `src/.*` matches the
# `src/` inside any third-party lib path like `.pio/libdeps/LovyanGFX/src/`.
# The `^(src|include)/` form covers both `src/foo.h` and `include/foo.h`
# emitted as relative paths when clang-tidy runs from `canshift-firmware/`.
HeaderFilterRegex: '^(src|include)/'

# Honour `.clang-format` for any auto-fix suggestions clang-tidy emits.
FormatStyle: file
