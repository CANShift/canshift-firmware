          "config": {
            "type": "gauge",
            "displayStyle": "numeric",
            "minValue": 0,
            "maxValue": 300,
            "warningLevel": 240,
            "dangerLevel": 280,
            "decimalPlaces": 0,
            "suffix": "km/h",
            "label": "SPEED",
            "labelPosition": "bottom-left"
          }
        },
        {
          "id": "coolant_num",
          "type": "gauge",
