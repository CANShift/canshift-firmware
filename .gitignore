# PlatformIO build cache and artifacts
.pio/

# clang-tidy compilation database (regenerated by `pio run -t compiledb`)
compile_commands.json

# Compiled binaries
*.bin
*.elf
*.hex
*.map

# Allow SPIFFS font + image assets
!data/fonts/*.bin
!data/assets/*.bin

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Environment
.env
.env.*

# Secure-boot artifacts — NEVER commit.
secrets/
keys/
*.pem

# Claude (local only)
.claude/
sim-screenshot.bmp
.worktrees/

__pycache__/
*.pyc

secure-boot/*/sdkconfig
secure-boot/*/build/
