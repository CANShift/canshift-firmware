---
# canshift-firmware — clang-format style
# Based on LLVM with Arduino/embedded-friendly adjustments.
# Run: clang-format -i $(find src include -name "*.cpp" -o -name "*.h" | grep -v lv_conf)

BasedOnStyle: LLVM
Language: Cpp

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
IndentCaseLabels: true
IndentPPDirectives: BeforeHash

# Line length
ColumnLimit: 100

# Braces
BreakBeforeBraces: Attach
InsertBraces: false

# Spacing
SpaceBeforeParens: ControlStatements
SpaceInEmptyBlock: false
SpacesInParens: Never
SpacesInSquareBrackets: false
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeCpp11BracedList: false

# Pointers & references — pointer on type side (int* p)
PointerAlignment: Right
ReferenceAlignment: Right

# Includes — keep #include order as-written, group blank-line separated blocks
SortIncludes: Never
IncludeBlocks: Preserve

# Line breaks
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AlwaysBreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeColon
BreakBeforeBinaryOperators: None

# Comments
ReflowComments: false

# Trailing commas
InsertTrailingCommas: None
