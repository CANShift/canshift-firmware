          "id": "rpm_gauge",
          "type": "gauge",
          "signal": "rpm",
          "layout": { "x": 2, "y": 0, "w": 156, "h": 140, "zOrder": 0 },
          "style": {
            "primaryColor": "#FF4444",
            "secondaryColor": "#2A2A2A",
            "warningColor": "#FF8800",
            "criticalColor": "#FF0000",
            "textColor": "#FFFFFF",
            "fontSize": 32
          },
          "config": {
            "type": "gauge",
            "displayStyle": "arc",
            "minValue": 0,
            "maxValue": 8000,
            "warningLevel": 6500,
            "dangerLevel": 7200,
            "decimalPlaces": 0,
            "showNeedle": false
          }
        },
        {
          "id": "speed_label",
          "type": "gauge",
          "signal": "speed_kph",
          "layout": { "x": 160, "y": 0, "w": 158, "h": 80, "zOrder": 0 },
          "style": {
            "textColor": "#FFFFFF",
            "primaryColor": "#FFFFFF",
