# .clangd — Language server config for canshift-firmware
#
# PlatformIO generates compile_commands.json after a first build:
#   pio run -e crowpanel_28
# clangd picks it up automatically once it exists at:
#   .pio/build/crowpanel_28/compile_commands.json
#
# Until that first build, all Arduino/LVGL/ESP32 headers are missing.
# The suppressions below silence those false positives so the IDE stays usable.

CompileFlags:
  # Point clangd at PlatformIO's generated database once it exists.
  # Build first with: pio run -e crowpanel_28
  CompilationDatabase: ".pio/build/crowpanel_28"
  Add:
    - "-Isrc"
    - "-Iinclude"
    - "-std=gnu++17"
    - "-DBOARD_CROWPANEL_28=1"
    - "-DAPP_SIMULATION_MODE=0"
    - "-DARDUINO=200"
    - "-DARDUINO_JSON_VERSION=7"
  Remove:
    - "-march=*"
    - "-mabi=*"

Diagnostics:
  # All errors below are false positives caused by missing PlatformIO toolchain
  # headers (Arduino.h, lvgl.h, FreeRTOS, etc.). They disappear after a first
  # `pio run` generates compile_commands.json with the real include paths.
  Suppress:
    - "pp_file_not_found"
    - "pp_including_mainfile_in_preamble"
    - "unknown_typename"
    - "undeclared_var_use"
