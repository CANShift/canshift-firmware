          "layout": { "x": 160, "y": 80, "w": 158, "h": 28, "zOrder": 0 },
          "style": {
            "textColor": "#888888",
            "primaryColor": "#888888",
            "secondaryColor": "#333333",
            "warningColor": "#FF8800",
            "criticalColor": "#FF0000",
            "fontSize": 14
