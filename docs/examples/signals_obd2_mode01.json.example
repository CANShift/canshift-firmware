{
  "_comment": "Example OBD-II signals.json — SAE J1979 Mode 01 PIDs (issue #841). Drop this in as data/config/signals.json (or push via Studio) to configure CANShift for a generic OBD-II vehicle. Each signal carries a `polling` block so the firmware sends a 0x7DF request at intervalMs and decodes the 0x7E8 response. Default v1.0 of canshift-firmware ships a MaxxECU broadcast catalog; this file is the OBD-II equivalent.",
  "version": "1.17.0",
  "protocol": "obd2_j1979",
  "canSpeedKbps": 500,
  "signals": [
    {
      "name": "rpm",
      "canFrameId": "0x7E8",
      "startByte": 3,
      "byteLength": 2,
      "bigEndian": true,
      "signed": false,
      "scale": 0.25,
      "offset": 0.0,
      "unit": "rpm",
      "min": 0,
      "max": 8000,
      "warningLevel": 6500,
      "dangerLevel": 7200,
      "timeoutMs": 2000,
      "polling": { "mode": 1, "pid": 12, "intervalMs": 250 }
    },
    {
      "name": "speed_kph",
      "canFrameId": "0x7E8",
      "startByte": 3,
      "byteLength": 1,
      "bigEndian": true,
      "signed": false,
      "scale": 1.0,
      "offset": 0.0,
      "unit": "km/h",
      "min": 0,
      "max": 255,
      "timeoutMs": 2000,
      "polling": { "mode": 1, "pid": 13, "intervalMs": 500 }
    },
    {
      "name": "coolant_temp_c",
      "canFrameId": "0x7E8",
      "startByte": 3,
      "byteLength": 1,
      "bigEndian": true,
      "signed": false,
      "scale": 1.0,
      "offset": -40.0,
      "unit": "°C",
      "min": -40,
      "max": 150,
      "warningLevel": 100,
      "dangerLevel": 115,
      "timeoutMs": 5000,
      "polling": { "mode": 1, "pid": 5, "intervalMs": 1000 }
    },
    {
      "name": "throttle_pos",
      "canFrameId": "0x7E8",
      "startByte": 3,
      "byteLength": 1,
      "bigEndian": true,
      "signed": false,
      "scale": 0.392156862745098,
      "offset": 0.0,
      "unit": "%",
      "min": 0,
      "max": 100,
      "timeoutMs": 2000,
      "polling": { "mode": 1, "pid": 17, "intervalMs": 500 }
    },
    {
      "name": "iat_c",
      "canFrameId": "0x7E8",
      "startByte": 3,
      "byteLength": 1,
      "bigEndian": true,
      "signed": false,
      "scale": 1.0,
      "offset": -40.0,
      "unit": "°C",
      "min": -40,
      "max": 215,
      "timeoutMs": 2000,
      "polling": { "mode": 1, "pid": 15, "intervalMs": 1000 }
    },
    {
      "name": "battery_volts",
      "canFrameId": "0x7E8",
      "startByte": 3,
      "byteLength": 2,
      "bigEndian": true,
      "signed": false,
      "scale": 0.001,
      "offset": 0.0,
      "unit": "V",
      "min": 8,
      "max": 18,
      "warningLevel": 12.0,
      "dangerLevel": 11.5,
      "timeoutMs": 5000,
      "polling": { "mode": 1, "pid": 66, "intervalMs": 2000 }
    }
  ]
}
